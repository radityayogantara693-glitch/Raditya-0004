# ─────────────────────────────────────────────────────────────
# Mode penyimpanan
# ─────────────────────────────────────────────────────────────
# Proyek ini memakai driver demo lokal: data disimpan sebagai JSON di
# ./.data/db.json (ubah lokasi lewat DATA_DIR bila perlu).
# Tidak ada layanan basis data eksternal yang diperlukan.
#
# Catatan: pada filesystem read-only (mis. Vercel) data hanya tersimpan
# di memori per instance dan tidak persisten.

# ─────────────────────────────────────────────────────────────
# Keamanan
# ─────────────────────────────────────────────────────────────
# Kunci penandatangan cookie sesi. Wajib diisi di produksi (min. 32 karakter).
SESSION_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter

# Token untuk endpoint /api/cron/release-no-show
CRON_SECRET=ganti-token-cron-acak

# ─────────────────────────────────────────────────────────────
# Email
# ─────────────────────────────────────────────────────────────
# "mock"  → email ditulis ke outbox (bisa dilihat di /admin/notifikasi)
# "resend"→ kirim sungguhan lewat Resend
EMAIL_DRIVER=mock
RESEND_API_KEY=
EMAIL_FROM=noreply@idb.ac.id

# ─────────────────────────────────────────────────────────────
# Aplikasi
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Sistem Peminjaman Ruangan IDB Bali
NEXT_PUBLIC_APP_URL=http://localhost:3000
