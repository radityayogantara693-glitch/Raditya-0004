# ─────────────────────────────────────────────────────────────
# Mode penyimpanan
# ─────────────────────────────────────────────────────────────
# Kosongkan NEXT_PUBLIC_SUPABASE_URL untuk memakai mode demo lokal
# (data disimpan di ./.data/db.json — cocok untuk pengembangan & UAT).
#
# Isi kedua nilai di bawah untuk memakai Supabase/PostgreSQL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Keamanan
# ─────────────────────────────────────────────────────────────
# Kunci penandatangan cookie sesi. Wajib diisi di produksi (min. 32 karakter).
SESSION_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter

# Token untuk endpoint /api/cron/release-no-show
CRON_SECRET=ganti-token-cron-acak

# Token untuk endpoint /api/admin/seed (menanam data demo ke Supabase)
SEED_SECRET=ganti-token-seed-acak

# ─────────────────────────────────────────────────────────────
# Email
# ─────────────────────────────────────────────────────────────
# "mock"  → email ditulis ke outbox (bisa dilihat di /admin/notifikasi)
# "resend"→ kirim sungguhan lewat Resend
EMAIL_DRIVER=mock
RESEND_API_KEY=
EMAIL_FROM=noreply@idb.ac.id

# ─────────────────────────────────────────────────────────────
# Aplikasi
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Sistem Peminjaman Ruangan IDB Bali
NEXT_PUBLIC_APP_URL=http://localhost:3000
